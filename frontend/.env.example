# Copiar a .env.local y completar. Nunca subir .env.local al repo.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Recuperar contraseña (/api/send-recovery)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Facturación ARCA (ver docs/facturacion-arca.md §4). Pegar el PEM completo; en Vercel los saltos de línea pueden ir como \n
NEXT_PUBLIC_ARCA_CUIT_SISTEMA=
ARCA_CERT_HOMO=
ARCA_KEY_HOMO=
ARCA_CERT=
ARCA_KEY=
